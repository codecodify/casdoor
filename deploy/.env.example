# ⚠️ 这是示例文件，所有值都是占位符，不是真实密码。
# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# .env 含密码，不要提交到 Git。

# 镜像标签（对应 git tag，例如 v4.24.0-codecodify.1）
CASDOOR_TAG=v4.24.0-codecodify.1

# 宿主机映射端口（容器内固定 8000）
CASDOOR_HTTP_PORT=8000

# 对外访问地址（反向代理后的 https 域名，末尾不要加 /）
CASDOOR_ORIGIN=https://auth.example.com

# Casdoor 运行模式：prod / dev
CASDOOR_RUNMODE=prod

# 首次启动时 built-in/admin 的初始密码（示例值，务必修改；建库后再改此值不生效）
CASDOOR_INIT_ADMIN_PASSWORD=change-me-admin-password

# 宿主机 MySQL 8（容器内通过 host.docker.internal 访问）
# 密码避免使用 @ / ? 等字符，否则会破坏连接串
DB_USER=casdoor
DB_PASSWORD=change-me-db-password
DB_NAME=casdoor
DB_PORT=3306

# 宿主机 Redis，格式 host:port[,poolSize[,password[,db]]]，留空表示不用 Redis
# 无密码：  host.docker.internal:6379
# 有密码：  host.docker.internal:6379,100,change-me-redis-password,0
REDIS_ENDPOINT=host.docker.internal:6379

TZ=Asia/Shanghai
